# API keys & URL — these are SECRETS. This file must never be committed or shared.
# Copy to .env and fill in (or use the in-game ⚙ Settings which writes them here).
LLM_API_URL=api_location_here
LLM_API_KEY=your_key_here
LLM_MODEL=ornith1535b
# Timeout per LLM call in ms. Keep at least 20000 — a local model (e.g. Ollama)
# may need to reload into VRAM before it can answer.
LLM_TIMEOUT_MS=20000

# Turn timeout in seconds (0 disables auto-pass)
TURN_TIMEOUT=90